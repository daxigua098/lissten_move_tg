# 必填：字段加密密钥（用于加密 Bot Token、API Hash 等敏感字段）
# 生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SECRET_KEY=

# 内置管理员初始密码（首次启动创建，登录后必须修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 可选：覆盖 configs/config.yaml 中的数据库地址
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 可选：服务间调用令牌（脚本 / CI 使用）
ADMIN_API_TOKEN=

# 可选：覆盖日志级别
# LOG_LEVEL=INFO

# Telegram API 凭据（my.telegram.org 申请）：绑定执行账号、校验 Bot Token 需要
TG_API_ID=
TG_API_HASH=
